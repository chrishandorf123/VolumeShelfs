{
  "name": "volumeshelfs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Anchored volume-profile analysis: volume shelves, break-even supply/demand zones, and volume gaps.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:trail": "tsc --noEmit && vite build --config vite.standalone.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
